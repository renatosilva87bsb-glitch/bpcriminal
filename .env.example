# Exposto somente no backend (Vercel Functions)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_PRIVADA
LEAD_HASH_SECRET=gere-um-segredo-aleatorio-longo-com-32-ou-mais-bytes
